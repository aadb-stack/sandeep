# ---------------------------------------------------------------------------
# AI Sales Engineer — environment variables
#
# Every integration below is OPTIONAL for local development. With none of these
# set, the app boots against in-memory mock adapters (mock auth/org, in-memory
# vector store, deterministic mock embeddings, canned chat responses, mock
# billing). Fill these in to switch each subsystem to its real provider.
# ---------------------------------------------------------------------------

# --- Database (Postgres + pgvector) ---
# When unset, an in-memory mock store is used.
DATABASE_URL=

# --- Auth & Orgs (Clerk) ---
# When unset, a deterministic mock org/user is used for all requests.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# --- LLM (Anthropic Claude via Vercel AI SDK) ---
# When unset, the chat route streams a canned mock answer.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-4-8
ANTHROPIC_MODEL=

# --- Embeddings (Voyage AI) ---
# When unset, deterministic hash-based mock embeddings are used.
VOYAGE_API_KEY=
# Optional override; defaults to voyage-3
VOYAGE_MODEL=

# --- Rate limiting / cache (Upstash Redis) ---
# When unset, an in-memory rate limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Billing (Stripe) ---
# When unset, billing endpoints run in mock mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=
NEXT_PUBLIC_STRIPE_TEAM_PRICE_ID=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
